import java.util.Scanner;

public class duplic2 {
    static Scanner scanner = new Scanner(System.in);
    static int col, row;
    static int[][] ray;

    public static void main(String[] args) {
        Title();
        Size();
        Display();
        Highlow();
        Duplicate();
    }

     public static void Title() {
        System.out.println("=======================================");
        System.out.println("                ARRAY      ");
        System.out.println("=======================================\n");
    }
     
    public static void Size() {
        System.out.print("Enter The Row of the Array: ");
        row = scanner.nextInt();

        System.out.print("Enter The Column of the Array: ");
        col = scanner.nextInt();

        ray = new int[row][col];

        System.out.println("Enter Your Value");
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                System.out.print("INDEX [" + i + "][" + j + "]: ");
                ray[i][j] = scanner.nextInt();
            }
        }
        System.out.println("\n---------------------------------------");
    }

    public static void Display() {
        System.out.println("\nDISPLAY OF ARRAY:");
        System.out.println("\n---------------------------------------");
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                System.out.print(ray[i][j] + " ");
            }
            System.out.println();
        }
        System.out.println("\n---------------------------------------");
    }

    public static void Highlow() {
        int highest = ray[0][0];
        int lowest = ray[0][0];
        int sum = 0;

        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                if (ray[i][j] > highest) {
                    highest = ray[i][j];
                }
                if (ray[i][j] < lowest) {
                    lowest = ray[i][j];
                }
                sum += ray[i][j];
            }
        }
        System.out.println("\n---------------------------------------");
        System.out.println("\nHighest Value: " + highest);
        System.out.println("Lowest Value: " + lowest);
        System.out.println("Sum of the array: " + sum);
        System.out.println("\n---------------------------------------");
    }

    public static void Duplicate() {
        boolean hasDuplicate = false;
        int duplicateCount = 0;
        System.out.println("\n---------------------------------------");
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                int current = ray[i][j];
                boolean alreadyChecked = false;

                
                for (int x = 0; x <= i; x++) {
                    for (int y = 0; y < col; y++) {
                        if (x == i && y >= j) break;
                        if (ray[x][y] == current) {
                            alreadyChecked = true;
                            break;
                        }
                    }
                    if (alreadyChecked) break;
                }

                if (alreadyChecked) continue;

                int count = 0;
                String indices = "";

                
                for (int m = 0; m < row; m++) {
                    for (int n = 0; n < col; n++) {
                        if (ray[m][n] == current) {
                            count++;
                            indices += "[" + m + "][" + n + "] ";
                        }
                    }
                }

                if (count > 1) {
                    hasDuplicate = true;
                    duplicateCount++;
                    System.out.println("\nDuplicate value: " + current + 
                        " appears " + count + " times at indices " + indices);
                }
            }
        }

        if (!hasDuplicate) {
            System.out.println("\nNo duplicates found.");
        } else {
            System.out.println("\nTotal distinct duplicate values found: " + duplicateCount);
        }
        System.out.println("\n---------------------------------------");
    }
}
