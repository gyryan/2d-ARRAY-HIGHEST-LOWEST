import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Enter Your Array Size : ");
        int size = scanner.nextInt();
        
        int[] aray = new int[size];
        
        for (int i = 0; i < size; i++) {
            System.out.print("ELEMENT INDEX [" + i + "] : ");
            aray[i] = scanner.nextInt();
        }

       
        System.out.println("\nDISPLAY OF ARRAY:");
        for (int i = 0; i < size; i++) {
            System.out.print(aray[i] + " "); 
        }
        System.out.println();


        int highest = aray[0];
        int lowest = aray[0];
        int sum = 0;

        
        for (int i = 0; i < size; i++) {
            if (aray[i] > highest) {
                highest = aray[i];
            }
            if (aray[i] < lowest) {
                lowest = aray[i];
            }
            sum += aray[i];
        }

       
        boolean hasDuplicate = false;
        for (int i = 0; i < size; i++) {
            for (int j = i + 1; j < size; j++) { 
                if (aray[i] == aray[j]) {
                    System.out.println("Duplicate found: " + aray[i] + "\nELEMENT INDEX AT [" + i + "] & [" + j + "]" );
                    hasDuplicate = true;
                }
            }
        }
        if (!hasDuplicate) {
            System.out.println("No duplicates");

        System.out.println("\nHighest Value: " + highest);
        System.out.println("Lowest Value: " + lowest);
        System.out.println("Sum of the array: " + sum);
    }
}
